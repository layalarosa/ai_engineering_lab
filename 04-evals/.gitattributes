eval_data/rag_baseline/run-*/*.json -text
eval_data/rag_baseline/run-*/*.jsonl -text
eval_data/rag_baseline/grounding-*/*.json -text
eval_data/rag_baseline/grounding-*/*.jsonl -text
eval_data/rag_baseline/live-*/*.json -text
eval_data/rag_baseline/live-*/*.jsonl -text
